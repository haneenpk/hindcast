# Copy to .env to configure a full-stack deployment
# (`docker compose --profile full up`), or just to move host ports when the
# defaults clash with something you already run. Containers always talk to
# each other on the internal defaults — these only change the app config and
# what's exposed on your machine.

# --- The full stack (docker compose --profile full up) ---

# The one secret that opens the dashboard. CHANGE THIS.
ADMIN_SECRET="change-me"

# The ingest host your recorders point at — the URL browsers hit, shown in
# the install snippet. On a real deploy this is your public ingest URL,
# e.g. https://ingest.example.com.
HINDCAST_INGEST_URL="http://localhost:4100"

# Serve the marketing landing at / (off by default — / goes to the app).
#HINDCAST_LANDING="true"

# --- Host ports (uncomment only if a default clashes) ---
#WEB_PORT=3000
#INGEST_PORT=4100
#POSTGRES_PORT=5432
#REDIS_PORT=6379
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
