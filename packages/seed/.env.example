# Matches the docker-compose defaults. Mirror the shifted ports from the
# root .env here if you moved them.
DATABASE_URL="postgresql://hindcast:hindcast@localhost:5432/hindcast"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="hindcast"
S3_SECRET_KEY="hindcast-dev"
S3_BUCKET="hindcast-events"
