generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

model Session {
  // Minted by the SDK in the browser, not by the database — events are
  // batched client-side before the server has ever heard of the session.
  id          String   @id
  projectId   String
  startedAt   DateTime
  lastEventAt DateTime
  entryUrl    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  EventChunk[]
  errors  ErrorEvent[]
  network NetworkEvent[]

  @@index([projectId, startedAt(sort: Desc)])
}

// One flushed batch of rrweb events, stored gzipped in object storage.
// Postgres keeps only enough to find and order the chunks.
model EventChunk {
  id           String   @id @default(cuid())
  sessionId    String
  seq          Int
  storageKey   String
  sizeBytes    Int
  eventCount   Int
  // Where the tab was when this batch flushed — powers the pages count
  // and, later, filtering sessions by page.
  pageUrl      String?
  firstEventAt DateTime
  lastEventAt  DateTime
  createdAt    DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
}

model ErrorEvent {
  id        String      @id @default(cuid())
  sessionId String
  timestamp DateTime
  source    ErrorSource
  message   String
  stack     String?
  pageUrl   String?
  createdAt DateTime    @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // The player seeks by time, so errors are looked up by session + timestamp.
  @@index([sessionId, timestamp])
}

// No body columns on purpose: request and response payloads are never
// captured by the SDK, so they can never end up in storage.
model NetworkEvent {
  id         String   @id @default(cuid())
  sessionId  String
  timestamp  DateTime
  method     String
  url        String
  status     Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

enum ErrorSource {
  WINDOW_ERROR
  UNHANDLED_REJECTION
  CONSOLE_ERROR
}
