# Matches the docker-compose defaults. If you moved ports in the root
# .env, mirror them here.
PORT=4100
DATABASE_URL="postgresql://hindcast:hindcast@localhost:5432/hindcast"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="hindcast"
S3_SECRET_KEY="hindcast-dev"
S3_BUCKET="hindcast-events"
