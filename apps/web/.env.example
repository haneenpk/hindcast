# The one secret that opens the dashboard. Pick something long.
ADMIN_SECRET="change-me"

# Matches the docker-compose defaults; mirror the root .env if you moved ports.
DATABASE_URL="postgresql://hindcast:hindcast@localhost:5432/hindcast"

# Where recorders send batches — shown in the install snippet.
NEXT_PUBLIC_INGEST_URL="http://localhost:4100"
