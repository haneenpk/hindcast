# The one secret that opens the dashboard. Pick something long.
ADMIN_SECRET="change-me"

# The public marketing landing at `/` is off by default — a self-hosted
# instance sends `/` straight to the dashboard. Set this to enable it (e.g.
# on a hosted demo): "true", "1" or "on".
# HINDCAST_LANDING="true"

# Matches the docker-compose defaults; mirror the root .env if you moved ports.
DATABASE_URL="postgresql://hindcast:hindcast@localhost:5432/hindcast"

# Where recorders send batches — shown in the install snippet.
NEXT_PUBLIC_INGEST_URL="http://localhost:4100"

# The player reads event chunks straight from object storage.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="hindcast"
S3_SECRET_KEY="hindcast-dev"
S3_BUCKET="hindcast-events"
